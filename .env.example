# flywheel backend selection (defaults: herdr / agentmail)
# Copy to `.env` and uncomment. Real `.env` is gitignored — never commit tokens.
#
# Precedence: CLI flag > env > this file (dotenvy) > config.toml > default
# Docs: AGENTS.md § Backends, docs/decisions/0002-pluggable-backend-abstraction.md

# FLYWHEEL_BACKEND=herdr          # herdr (default) | superlogical (stub) | tmux (stub)
# FLYWHEEL_MAIL=agentmail         # agentmail (default) | toron (stub until ADR-0003 R1)

# agent-mail MCP (used when FLYWHEEL_MAIL=agentmail)
# FLYWHEEL_AGENTMAIL_URL=http://127.0.0.1:8765
# FLYWHEEL_AGENTMAIL_TOKEN=       # never commit a real token
# FLYWHEEL_MAIL_NAME=             # optional orchestrator agent-mail identity

# optional: herdr socket / workspace / Resonate
# FLYWHEEL_SOCKET=~/.config/herdr/herdr.sock
# FLYWHEEL_ROOT=~/workspace
# RESONATE_URL=http://localhost:8001
