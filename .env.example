# flywheel backend selection (defaults: herdr / toron)
# Copy to `.env` and uncomment. Real `.env` is gitignored — never commit tokens.
#
# Precedence: CLI flag > env > this file (dotenvy) > config.toml > default
# Docs: AGENTS.md § Backends, docs/decisions/0002-pluggable-backend-abstraction.md

# FLYWHEEL_BACKEND=herdr          # herdr (default) | superlogical (stub)
# FLYWHEEL_MAIL=toron             # toron (the only mail backend since bd-euav)

# toron daemon transport (used when [mail.toron] url is unset) — feeds
# [mail.toron] ONLY (bd-euav)
# FLYWHEEL_TORON_URL=http://127.0.0.1:18080
# FLYWHEEL_TORON_TOKEN=       # never commit a real token
# FLYWHEEL_MAIL_NAME=             # optional shared orchestrator identity ([agent_mail] name)

# optional: herdr socket / workspace / Resonate
# FLYWHEEL_SOCKET=~/.config/herdr/herdr.sock
# FLYWHEEL_ROOT=~/workspace
# RESONATE_URL=http://localhost:8001
# FLYWHEEL_VERBOSE=1  # show operator notes (e.g. the superseded-store note)

# judgment (ADR-0014, bd-0glq P7: on by default when the key is present).
# Unset FLYWHEEL_JEV = auto (enrich iff TYPESAFE_API_KEY is set, else loud
# table passthrough marked `jev: unconfigured`); 1/true/yes = force on
# (deny escalates even keyless); 0/false/no = force off (byte-identical).
# FLYWHEEL_JEV=1
# TYPESAFE_API_KEY=      # mikasa-only custody; never commit a real key
# FLYWHEEL_JEV_THRESHOLDS=0.85,0.80,0.60  # provisional topology,honesty,announce (captain-tunable)
