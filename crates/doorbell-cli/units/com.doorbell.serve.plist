<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- governed-by: ADR-0012 — com.doorbell.serve (doorbell plane-D daemon) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.doorbell.serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>DOORBELL_BIN</string>
        <string>serve</string>
        DOORBELL_SERVE_ARGS
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart=on-failure semantics: a clean exit (e.g. port conflict,
         which exits 0) must STAY dead — no respawn war (bd-serve-double-spawn).
         launchd has no SuccessfulExit key; the binary exits 0 on conflict
         and non-zero on crash, and KeepAlive/SuccessfulExit=false pairs it. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <!-- bd-m7yp: launchd's default soft maxfiles for a job is 256, and this
         daemon is a SERVER: it holds one descriptor per wake subscriber and
         one per hosted workspace. Measured: 257 descriptors against the 256
         cap, so it could not open a socket and the wake brain could not reach
         a pane. The budget has to match the working set. -->
    <key>LimitMaxFiles</key>
    <integer>4096</integer>
    <key>StandardOutPath</key>
    <string>DOORBELL_STATE_DIR_VALUE/doorbell.log</string>
    <key>StandardErrorPath</key>
    <string>DOORBELL_STATE_DIR_VALUE/doorbell.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>DOORBELL_STATE_DIR_KEY</key>
        <string>DOORBELL_STATE_DIR_VALUE</string>
        <key>DOORBELL_TORON_MCP_URL_KEY</key>
        <string>DOORBELL_TORON_MCP_URL_VALUE</string>
        <!-- bd-24mm: launchd runs the job with a minimal environment - no
             HOME, and a PATH that does not include ~/.local/bin - so the
             daemon cannot resolve herdr and its fail-closed boot gate
             (bd-fuql) refuses to host anything. The installer resolves both
             bins while HOME is still available and writes the absolute paths
             here; the daemon's env override wins verbatim. -->
        <key>DOORBELL_TORON_BIN_KEY</key>
        <string>DOORBELL_TORON_BIN_VALUE</string>
        <key>DOORBELL_HERDR_BIN_KEY</key>
        <string>DOORBELL_HERDR_BIN_VALUE</string>
    </dict>
</dict>
</plist>
